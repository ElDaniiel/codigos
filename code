color_tasa =
VAR min_val =
    MINX(ALL(insumoGMI), [Tasa_gral])

VAR max_val =
    MAXX(ALL(insumoGMI), [Tasa_gral])

VAR rango = max_val - min_val

VAR valor_norm =
    DIVIDE([Tasa_gral] - min_val, rango)

RETURN
    SWITCH(
        TRUE(),
        valor_norm <= 0.2, "#FF0000",
        valor_norm <= 0.4, "#FF7F00",
        valor_norm <= 0.6, "#FFFF00",
        valor_norm <= 0.8, "#7FFF00",
        "#00B050"
    )